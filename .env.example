# Copy to .env for scripts (setup-local, seed, integration tests).
# Lambda containers read their env from template.yaml + env.local.json, not this file.
# Never put AWS access keys here — use `aws configure` / AWS_PROFILE instead.

AWS_REGION=ap-south-1
STAGE=local

DYNAMODB_TABLE=personal-os-local
# Leave empty in AWS so the SDK uses the regional endpoint.
DYNAMODB_ENDPOINT=http://localhost:8000

S3_BUCKET=personal-os-documents-local
# Local S3-compatible storage (MinIO from docker-compose). Leave empty in AWS.
S3_ENDPOINT=http://localhost:9000
# Endpoint embedded in presigned URLs (must be reachable from the browser).
S3_PUBLIC_ENDPOINT=http://localhost:9000
# MinIO's local-only credentials (docker-compose.yml). Leave empty in AWS.
S3_ACCESS_KEY_ID=knot-local
S3_SECRET_ACCESS_KEY=knot-local-secret

# Comma-separated list of origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000

# Until Cognito is added every request is attributed to this user.
DEFAULT_USER_ID=usr_demo

# Google Drive integration (optional). Create an OAuth client in Google Cloud
# (see docs/google-drive.md). Never commit the secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/integrations/google-drive/callback
